# Copy this file to .env and fill in the values before running the app

# YouTube API key (create one in Google Cloud Console -> APIs & Services -> Credentials)
# If you don't have one for development, set a placeholder and the fetch tests will be skipped.
YOUTUBE_API_KEY=your_youtube_api_key_here

# MongoDB connection string (local or Atlas)
# Example local: mongodb://localhost:27017/youtube_tracker
MONGO_URI=

# Server port
PORT=5001

# Environment: development | production
NODE_ENV=development
